# TRACE Environment Variables (Placeholders Only)

# Server Configuration
TRACE_PORT=8000
TRACE_HOST=0.0.0.0
TRACE_ENV=development

# LLM Provider Configuration ("mock" for offline testing, "openai" for OpenAI API)
TRACE_LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Defaults to local trace.db in root)
DATABASE_URL=sqlite+aiosqlite:///./trace.db
